# `npm run dev` only. Never applied by `npm run build`, so nothing here can
# reach the binary that ships.
#
# The in-memory mock backend (`src/lib/api/mock.ts`), selected by the single
# switch in `src/lib/api/client.ts`. It exists so the UI can be developed
# without a running Rust server; set it to 0 to point `npm run dev` at a real
# one (the API paths are proxied to 127.0.0.1:8081 — see vite.config.ts).
VITE_API_MOCK=1
