[Unit]
Description=Stowcloud native SMB agent (applies sc-server's rendered smb.conf)
# Deliberately not Requires= or After= the samba unit: this agent is what
# starts it, once sc-server has written a config that testparm accepts. On a
# host where SMB has never been enabled there is nothing for samba to serve.
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/lib/sc/sc-smb-agent.sh
Restart=on-failure
RestartSec=5
# Root is the point -- it edits /etc/passwd and the samba passdb. Everything
# it does not need is dropped instead.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
# /etc must stay writable: /etc/passwd and /etc/samba/smb.conf are the two
# things this agent exists to rewrite.
ProtectSystem=false

[Install]
WantedBy=multi-user.target
