# The whole configuration. There is no environment override: a server whose
# settings come from two places is one where "what is it running with" is a
# question rather than a file.

[server]
# Where the store, the certificate and the setup token live.
data_dir = "/var/lib/stowcloud"

# The bind address. Not loopback: a published port targets the container's
# bridge interface, so a server bound to loopback is unreachable from outside
# its own network namespace whatever the port mapping says.
#
# Whatever address it names, that socket serves TLS and nothing else.
listen = "0.0.0.0:8443"

[http]
# Every name this server answers for. A guard that learned its origin from the
# request it guards is not a guard, so this has no default and an empty list is
# a refused startup.
#
# A name that is not listed gets a refusal rather than the site, so list every
# name you actually browse to.
app_hosts = ["stowcloud.example.com"]

# The origin user content is served from. It is separate so that a malicious
# upload cannot execute in the origin holding the session cookie.
content_hosts = ["content.stowcloud.example.com"]

# The ranges a forwarded client address is trusted from. Without them every
# request folds onto the proxy's own address, and the login limiter, the API
# limiter and the audit log all become useless together in a way that looks
# like nothing is wrong.
#
# These are the proxy's addresses as this container sees them, which is not
# loopback: a published port rewrites the destination, not the source.
trusted_proxy_cidrs = []

[rate]
per_sec = 20
burst = 100

[security]
# What is asked of the sandbox. The shipped default refuses to start when a
# layer cannot be applied; "preferred" reports it as a named degradation on the
# health endpoint and keeps running; "off" attempts nothing and says so.
#
# None of the three affects the path resolver, which is a refusal to start
# under all of them: "off" means a weaker sandbox is accepted, not a resolver
# that can be raced.
hardening = "required"

[db]
# The store's disk bound. Off by default, and that is deliberate rather than an
# oversight: an instance that stops accepting writes because a cache grew is
# worse than one that uses more disk than expected. Hardening above fails the
# other way, and the split is the point: fail closed on a security control,
# fail open on the user's own data.
#
# Turning it on with neither bound below set is a refused startup, because a
# guard that can never trip reads as protection and is not.
size_guard = false

# Block writes when the volume holding the data directory has less than this
# available. A tripped guard refuses the writes that grow a database and keeps
# serving reads, and the health endpoint reports it.
# min_free_bytes = 1073741824

# Block writes when the three databases together exceed this. A bound on this
# server's own footprint, where min_free_bytes is a bound on the volume it
# shares with everything else.
# max_bytes = 10737418240

[smb]
# Whether SMB is published at all. Off by default: SMB starts explicitly.
#
# This server renders the configuration and cannot apply it. The daemon runs in
# the sidecar container, in a network namespace that can see the host's
# devices, as a user that may edit the system account file. So this writes four
# files into a directory both containers mount, and asks the sidecar to apply
# them.
enabled = false

# The account every SMB connection runs as. Required when SMB is enabled here;
# left out with SMB off it defaults to scsvc, the account Dockerfile.smb
# creates, so the settings screen shows the name a deployment would get rather
# than a blank box. Real per-user access control is the grants this server
# holds, which become the per-share account lists; this identity only decides
# what a connection writes as on disk.
service_user = "scsvc"

# (Each [[shares]] entry below also takes `trash_enabled`, off by default: a
# deleted file is removed rather than kept, because trash is disk somebody has
# to reclaim and a server that quietly keeps everything fills up. An
# administrator can turn it on per share from the settings screen instead.
#
# And `symlink_policy`, one of:
#
#   "deny"          the default: a symlink is visible in a listing and cannot
#                   be opened or traversed.
#   "within_share"  follow it as long as the target stays inside this share.
#                   An absolute target is rebased into the share.
#   "follow"        follow a relative symlink. An absolute target still fails;
#                   nothing reaches outside the share under any of the three.
#
# A value this build does not implement is a refused startup rather than a
# warning and a fallback: an operator who wrote a typo and silently got "deny"
# believes a share follows links that it does not.)

# The numeric group every rendered SMB account is put in. It must be a group
# that exists in the sidecar's own container, which is what the published
# account file is read against.
#
# The default is 1000, the group `Dockerfile.smb` creates, so a stock container
# deployment leaves this alone. A bare-metal install that made its service
# account elsewhere sets its own number here.
#
# Getting it wrong is a loud failure rather than a quiet one: the sidecar
# refuses the whole sync with "no group exists for N" and keeps serving what it
# already had.
# service_gid = 1000

workgroup = "WORKGROUP"

# The name clients can reach this server by, so a share opens under a name
# rather than an address. Empty means no name at all: the name service stays
# off and only the address works.
#
# A name only resolves when the sidecar shares the LAN's broadcast domain,
# because name service is broadcast and does not cross a bridge.
server_name = ""

# Pins exactly which addresses may be bound, overriding the detection the
# sidecar would otherwise do. Addresses and CIDR blocks only.
#
# Empty does not mean "bind everything". It means the closed case: this process
# runs in a different network namespace from the one that binds, so it renders
# loopback only and the sidecar expands it from the host's own devices.
interfaces = []

# Lets a globally routable address be bound. Whether one exists at all is only
# knowable in the namespace that binds, which is why this is worth stating
# deliberately: turning it on means SMB is on the internet.
allow_public_bind = false

# The directory both containers mount, where the rendered files go.
config_dir = "/config/smb"

# Where the sidecar listens. Empty means no sidecar, which is a bare-metal
# deployment where something else applies the files: they are still written,
# and nothing reports back what happened to them.
agent_socket = "/run/sc-smb/agent.sock"

[oidc]
# Single sign-on through an external identity provider. Off by default.
#
# Link-only, and that is the position rather than a scope decision: the provider
# authenticates and never creates an account here, so authority over who has one
# stays in this server's database. That is what makes disabling an account here
# total, whatever the provider still says.
enabled = false

# The provider's issuer URL. Discovery is fetched from it, and everything the
# flow uses comes from that document rather than from keys here.
issuer = "https://idp.example.com"

client_id = ""
client_secret = ""

# What the sign-in button says. The issuer URL and the client id are never sent
# to an anonymous caller: whether single sign-on exists is all one needs to know
# to draw the button.
display_name = "Single sign-on"

# Extra scopes. The one that makes an identity token be issued at all is always
# requested, because without it the flow completes and returns nothing this
# server can verify.
scopes = []

# Allows a provider on this server's own network. Off by default: an address
# check is what stops a hostile discovery document pointing the back channel,
# which carries the client secret, at something inside the perimeter.
allow_private_endpoints = false

# Trust anchors for the back channel, replacing the system's. An empty file is a
# startup refusal rather than a silent downgrade: a pool that verifies nothing
# is how an operator ends up turning verification off.
ca_cert_file = ""
