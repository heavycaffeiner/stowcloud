{
  "group": "errors",
  "note": "One request per row of the error tables, and one per D5 bound at the bound and one past it. The point of the group is that a refusal keeps its status, its code and its shape, because a client branches on all three.",
  "requests": [
    {
      "name": "no credential at all",
      "method": "GET",
      "path": "/api/fs/list?path=docs",
      "auth": "none"
    },
    {
      "name": "a session cookie that is not one",
      "method": "GET",
      "path": "/api/fs/list?path=docs",
      "auth": "bad-session"
    },
    {
      "name": "an expired session",
      "method": "GET",
      "path": "/api/fs/list?path=docs",
      "auth": "expired-session"
    },
    {
      "name": "a bearer token that is not one",
      "method": "GET",
      "path": "/api/fs/list?path=docs",
      "auth": "none",
      "headers": { "Authorization": "Bearer not-a-real-token" }
    },
    {
      "name": "login with an unknown account",
      "method": "POST",
      "path": "/api/auth/password",
      "auth": "none",
      "headers": { "Content-Type": "application/json" },
      "body": "{\"username\":\"nobody-here\",\"password\":\"whatever\"}"
    },
    {
      "name": "login with the wrong password",
      "method": "POST",
      "path": "/api/auth/password",
      "auth": "none",
      "headers": { "Content-Type": "application/json" },
      "body": "{\"username\":\"alice\",\"password\":\"not-the-password\"}"
    },
    {
      "name": "login with a body that is not JSON",
      "method": "POST",
      "path": "/api/auth/password",
      "auth": "none",
      "headers": { "Content-Type": "application/json" },
      "body": "not json"
    },
    {
      "name": "login with no body",
      "method": "POST",
      "path": "/api/auth/password",
      "auth": "none",
      "headers": { "Content-Type": "application/json" },
      "body": ""
    },
    {
      "name": "a state-changing request with no origin",
      "method": "POST",
      "path": "/api/fs/mkdir",
      "auth": "session-no-origin",
      "headers": { "Content-Type": "application/json" },
      "body": "{\"path\":\"docs/from-the-differ\"}"
    },
    {
      "name": "a state-changing request from another origin",
      "method": "POST",
      "path": "/api/fs/mkdir",
      "auth": "session",
      "headers": {
        "Content-Type": "application/json",
        "Origin": "https://attacker.invalid"
      },
      "body": "{\"path\":\"docs/from-elsewhere\"}"
    },
    {
      "name": "a request body at the general bound",
      "method": "POST",
      "path": "/api/fs/mkdir",
      "auth": "session",
      "headers": { "Content-Type": "application/json" },
      "body": "@@BODY_AT_LIMIT@@"
    },
    {
      "name": "a request body one byte past the bound",
      "method": "POST",
      "path": "/api/fs/mkdir",
      "auth": "session",
      "headers": { "Content-Type": "application/json" },
      "body": "@@BODY_PAST_LIMIT@@"
    },
    {
      "name": "an XML body at the bound",
      "method": "PROPFIND",
      "path": "/dav/docs",
      "auth": "session",
      "headers": { "Depth": "0", "Content-Type": "application/xml" },
      "body": "@@XML_AT_LIMIT@@"
    },
    {
      "name": "an XML body one byte past the bound",
      "method": "PROPFIND",
      "path": "/dav/docs",
      "auth": "session",
      "headers": { "Depth": "0", "Content-Type": "application/xml" },
      "body": "@@XML_PAST_LIMIT@@"
    },
    {
      "name": "a host this server does not answer for",
      "method": "GET",
      "path": "/api/fs/list?path=docs",
      "auth": "session",
      "host": "not-a-configured-host.invalid"
    },
    {
      "name": "the content origin asked for an app route",
      "method": "GET",
      "path": "/api/fs/list?path=docs",
      "auth": "session",
      "host": "@@CONTENT_HOST@@"
    },
    {
      "name": "a share link token that is not one",
      "method": "GET",
      "path": "/s/not-a-real-token",
      "auth": "none"
    },
    {
      "name": "a share link token of the right shape that was never minted",
      "method": "GET",
      "path": "/s/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "auth": "none"
    }
  ]
}
