{
  "group": "rest",
  "note": "Every native route, with valid, invalid and boundary inputs. Checked in rather than generated, so a difference is reproducible and a regression is a diff.",
  "requests": [
    {
      "name": "health, no credential",
      "method": "GET",
      "path": "/api/health",
      "auth": "none"
    },
    {
      "name": "setup state, no credential",
      "method": "GET",
      "path": "/api/setup",
      "auth": "none"
    },
    {
      "name": "session, authenticated",
      "method": "GET",
      "path": "/api/auth/session",
      "auth": "session"
    },
    {
      "name": "session, no credential",
      "method": "GET",
      "path": "/api/auth/session",
      "auth": "none"
    },
    {
      "name": "list the share root",
      "method": "GET",
      "path": "/api/fs/list?path=docs",
      "auth": "session"
    },
    {
      "name": "list a subdirectory",
      "method": "GET",
      "path": "/api/fs/list?path=docs/sub",
      "auth": "session"
    },
    {
      "name": "list a path that does not exist",
      "method": "GET",
      "path": "/api/fs/list?path=docs/no-such-directory",
      "auth": "session"
    },
    {
      "name": "list a share nobody granted",
      "method": "GET",
      "path": "/api/fs/list?path=secrets/anything",
      "auth": "session"
    },
    {
      "name": "list with a traversal",
      "method": "GET",
      "path": "/api/fs/list?path=docs/../../etc",
      "auth": "session"
    },
    {
      "name": "list with an absolute path",
      "method": "GET",
      "path": "/api/fs/list?path=/etc/passwd",
      "auth": "session"
    },
    {
      "name": "list with no path at all",
      "method": "GET",
      "path": "/api/fs/list",
      "auth": "session"
    },
    {
      "name": "stat a file",
      "method": "GET",
      "path": "/api/fs/stat?path=docs/a.txt",
      "auth": "session"
    },
    {
      "name": "stat a directory",
      "method": "GET",
      "path": "/api/fs/stat?path=docs/sub",
      "auth": "session"
    },
    {
      "name": "read a small file",
      "method": "GET",
      "path": "/api/fs/read?path=docs/a.txt",
      "auth": "session"
    },
    {
      "name": "read a directory",
      "method": "GET",
      "path": "/api/fs/read?path=docs/sub",
      "auth": "session"
    },
    {
      "name": "a path at the component bound",
      "method": "GET",
      "path": "/api/fs/list?path=docs/@@DEEP_AT_LIMIT@@",
      "auth": "session"
    },
    {
      "name": "a path one component past the bound",
      "method": "GET",
      "path": "/api/fs/list?path=docs/@@DEEP_PAST_LIMIT@@",
      "auth": "session"
    },
    {
      "name": "a name at the byte bound",
      "method": "GET",
      "path": "/api/fs/stat?path=docs/@@NAME_AT_LIMIT@@",
      "auth": "session"
    },
    {
      "name": "a name one byte past the bound",
      "method": "GET",
      "path": "/api/fs/stat?path=docs/@@NAME_PAST_LIMIT@@",
      "auth": "session"
    },
    {
      "name": "a method the route does not have",
      "method": "DELETE",
      "path": "/api/fs/list?path=docs",
      "auth": "session"
    },
    {
      "name": "a route that does not exist",
      "method": "GET",
      "path": "/api/no-such-route",
      "auth": "session"
    },
    {
      "name": "the admin surface as a non-admin",
      "method": "GET",
      "path": "/api/admin/server-settings",
      "auth": "session"
    },
    {
      "name": "the upload protocol discovery",
      "method": "OPTIONS",
      "path": "/api/uploads",
      "auth": "none"
    },
    {
      "name": "an upload session that does not exist",
      "method": "HEAD",
      "path": "/api/uploads/AAAAAAAAAAAAAAAAAAAAAA",
      "auth": "session",
      "headers": { "Tus-Resumable": "1.0.0" }
    },
    {
      "name": "an upload id that is not one",
      "method": "HEAD",
      "path": "/api/uploads/not-an-id",
      "auth": "session",
      "headers": { "Tus-Resumable": "1.0.0" }
    }
  ]
}
