# Keep the build context small and, more importantly, make the image build
# self-contained: nothing host-built (a stale frontend/build from a previous
# `npm run build` on this machine, a leftover node_modules with
# platform-specific native bindings) can leak into what Docker builds. The
# frontend and the server binary are both built fresh inside their own stages
# every time.

# The Go build cache and any local build output.
backend/.tools
.dev

# Frontend, rebuilt from source in the `frontend` stage. Local .env files stay
# on the host, so nothing set in them can end up embedded in the image.
frontend/node_modules
frontend/build
frontend/.env
frontend/.env.development
frontend/.env.*.local

# VCS / editor / OS noise
.git
.gitignore
.gitattributes
*.log

# Repo-local scratch dirs unrelated to the image (see root .gitignore)
.demo
.smoke
.vm
.ref
*.qcow2

# Secrets that must never enter a build context or an image layer
setup-token
**/*.key
**/master.key
.env
