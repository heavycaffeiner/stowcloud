# OpenRouter credentials for Jev model
# Keep this file template committed; copy to .env (gitignored) for local use.

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
JEV_MODEL=typesafe/jev-1.13

# Pricing and cost limits (USD)
JEV_PRICE_PER_M_INPUT=0.042

# PR lane limits
JEV_PR_MAX_ACTIONS=40
JEV_PR_MAX_DECISIONS=50
JEV_PR_BUDGET_USD=0.05
JEV_PR_TIMEOUT_SECS=60

# Nightly lane limits
JEV_NIGHTLY_MAX_ACTIONS=150
JEV_NIGHTLY_MAX_DECISIONS=500
JEV_NIGHTLY_BUDGET_USD=0.50
JEV_NIGHTLY_TIMEOUT_SECS=300

# Optional text helper model (only needed if generating free-form text)
# HELPER_MODEL_API_KEY=
# HELPER_MODEL=
